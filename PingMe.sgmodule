#!name=PingMe for Surge
#!desc=PingMe 自动签到+视频奖励（Surge 兼容版）
#!author=Hermes
#!homepage=https://github.com/ZenmoFeiShi/Qx
#!system=ios

[Script]
PingMe_Capture = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalance(?:AndBonus)?,script-path=https://raw.githubusercontent.com/lingkai995/PingMe/main/PingMe.surge.js,debug=true
PingMe_Cron = type=cron,cronexp="42 11 * * *",script-path=https://raw.githubusercontent.com/lingkai995/PingMe/main/PingMe.surge.js,debug=true

[MITM]
hostname = %APPEND% api.pingmeapp.net
